0C3CC                           ; Clear RAM at $0000-$07FF
0C3CC                           ; ========================
0C3CC                           
0C3CC                           clear_ram:
0C3CC A9 07                     lda     #$07    ; high byte of last RAM page
0C3CE 85 FF                     sta     $FF
0C3D0 A9 00                     lda     #$00    ; low byte of last RAM page
0C3D2 85 FE                     sta     $FE
0C3D4                           clear_it:
0C3D4 A4 FF                     ldy     $FF ; load high byte of address
0C3D6 C0 01                     cpy     #$01    ; if it equals 1...
0C3D8 F0 07                     beq     +       ; ... skip (don't mess with stack at $0100-$01FF)
0C3DA A0 00                     ldy     #$00
0C3DC                           -
0C3DC 91 FE                     sta     ($FE),y
0C3DE C8                        iny
0C3DF D0 FB                     bne     -
0C3E1                           +
0C3E1 C6 FF                     dec     $FF ; decrement high byte of address
0C3E3 10 EF                     bpl     clear_it
0C3E5 60                        rts
0C3E6                           
0C3E6                           ; Read joypad
0C3E6                           ; ===========
0C3E6                           ; Returns: JOY_STAT = status of all buttons
0C3E6                           
0C3E6                           read_joypad:
0C3E6 A0 01                     ldy     #$01
0C3E8 8C 16 40                  sty     $4016   ; reset strobe
0C3EB 88                        dey
0C3EC 8C 16 40                  sty     $4016   ; clear strobe
0C3EF                           ;sty     JOY_STAT ; JOY_STAT = 0 (clear all button bits)
0C3EF A0 08                     ldy     #$08    ; do all 8 buttons
0C3F1                           
0C3F1                           read_button:
0C3F1 AD 16 40                  lda     $4016   ; load button status
0C3F4 29 01                     and     #$01    ; only keep lowest bit
0C3F6 4A                        lsr     a       ; transfer to carry flag
0C3F7 26 FC                     rol     $FC
0C3F9 88                        dey
0C3FA D0 F5                     bne     read_button
0C3FC 60                        rts
0C3FD                           
