0C0EC 20 D4 C2                  jsr		sprite_dma
0C0EF                           
0C0EF                           ; the next piece of code handles button presses
0C0EF                           
0C0EF A9 01                     lda     #%00000001
0C0F1 25 FC                     and     $FC
0C0F3 F0 07                     beq     +
0C0F5 25 FD                     and     $FD ; If this AND results in a non-zero result, it means
0C0F7 D0 03                     bne     +        ;  the button was pressed last refresh too, so do nothing.
0C0F9 20 67 C1                  jsr     right_pressed       ; Do appropriate action for this button
0C0FC                           +       ; Repeat for the other 7 buttons...
0C0FC A9 02                     lda     #%00000010
0C0FE 25 FC                     and     $FC
0C100 F0 07                     beq     +
0C102 25 FD                     and     $FD
0C104 D0 03                     bne     +
0C106 20 73 C1                  jsr     left_pressed
0C109                           +
0C109 A9 04                     lda     #%00000100
0C10B 25 FC                     and     $FC
0C10D F0 07                     beq     +
0C10F 25 FD                     and     $FD
0C111 D0 03                     bne     +
0C113 20 7F C1                  jsr     down_pressed
0C116                           +
0C116 A9 08                     lda     #%00001000
0C118 25 FC                     and     $FC
0C11A F0 07                     beq     +
0C11C 25 FD                     and     $FD
0C11E D0 03                     bne     +
0C120 20 8B C1                  jsr     up_pressed
0C123                           +
0C123 A9 10                     lda     #%00010000
0C125 25 FC                     and     $FC
0C127 F0 07                     beq     +
0C129 25 FD                     and     $FD
0C12B D0 03                     bne     +
0C12D 20 97 C1                  jsr     start_pressed
0C130                           +
0C130 A9 20                     lda     #%00100000
0C132 25 FC                     and     $FC
0C134 F0 07                     beq     +
0C136 25 FD                     and     $FD
0C138 D0 03                     bne     +
0C13A 20 B8 C1                  jsr     select_pressed
0C13D                           +
